module Iou.Iou where
import Daml.Script

data Cash = Cash with
    amount: Decimal
    currency: Text
        deriving(Eq, Show)

template Iou
    with
        issuer: Party
        owner: Party
        cash: Cash

    where
        signatory issuer, owner

        choice TransferProposal: ContractId IouTransferProposal
            with
                new_owner: Party
            controller owner
            do
                assertMsg "new owner cannot be the same owner" (owner /= new_owner)
                create IouTransferProposal with
                    iou = this
                    new_owner

template IouProposal
    with
        iou: Iou
    where
        signatory iou.issuer
        observer iou.owner
    
        choice ProposalAccept: ContractId Iou
            controller iou.owner
            do
                create iou

template IouTransferProposal
    with
        iou: Iou
        new_owner: Party
    where
        signatory (signatory iou) -- same as iou.owner iou.issuer
        observer new_owner

        choice CancelTransfer: ContractId Iou
            controller iou.owner
                do
                    create iou
        
        choice RejectTransfer: ContractId Iou
            controller new_owner
                do
                    create iou
        
        choice AccceptTransfer: ContractId Iou
            controller new_owner
                do
                    create iou with
                        owner = new_owner

testIouTransfer = do
    issuer <- allocateParty "Alice"
    owner <- allocateParty "Bob"

    iouProposal <- submit issuer do
        createCmd IouProposal with
            iou = Iou with
                issuer
                owner
                cash = Cash with
                    amount = 100.00
                    currency = "USD" 
    submit owner do
        exerciseCmd iouProposal ProposalAccept