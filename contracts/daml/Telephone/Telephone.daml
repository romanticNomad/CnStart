module Telephone.Telephone where
import Daml.Script

template Contact
    with
        owner: Party
        contact: Party
        address: Text
        telephone: Text
    where
        signatory owner
        observer contact

        choice UpdateTelephone : ContractId Contact
            with
                new_telephone: Text
            controller owner
            do
                create this with
                    telephone = new_telephone
        
        choice UpdateAddress : ContractId Contact
            with
                new_address: Text
            controller contact
            do
                create this with
                    address = new_address

testContact = do
    owner <- allocateParty "Alice"
    contact <- allocateParty "Bob"

    contactCid <- submit owner do
        createCmd Contact with
            owner
            contact
            address = "My House"
            telephone = "1234567890"
    
    submitMustFail contact do
        exerciseCmd contactCid UpdateTelephone with
            new_telephone = "1592634870"

    newContactId <- submit owner do
        exerciseCmd contactCid UpdateTelephone with
            new_telephone = "1472583690"

    newContrcatId1 <- submit contact do
        exerciseCmd newContactId UpdateAddress with
            new_address = "My other address"

    pure() 